# --- окружение ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=buildplanner.log

# --- внешние сервисы пайплайна ---
URBAN_API=https://urban-api.testing.idulab.ru
GENPLANNER_API=http://genplanner:8080
GENBUILDER_API=http://genbuilder:8080
CHAT_STORAGE_API=http://chat-history:8080

# --- LLM (vLLM, OpenAI-совместимый) ---
LLM_API=http://vllm:8000/v1
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=900

# --- Keycloak (service account: ChatStorage + запись сценариев в Urban API) ---
KEYCLOAK_URL=
KEYCLOAK_REALM=IDU
KEYCLOAK_CLIENT_ID=buildplanner
KEYCLOAK_CLIENT_SECRET=

# --- публикация результата и запуск расчёта оценок ---
# Без сервисной учётки запись выключается сама, с предупреждением в логе.
PUBLISH_TO_URBAN=true
SERVICE_PROJECT_PREFIX=BuildPlanner
PUBLISH_ZONE_SOURCE=BuildPlanner
PUBLISH_MAX_CONCURRENCY=8

# --- таймауты и лимиты пайплайна ---
URBAN_API_TIMEOUT_SECONDS=60
GENPLANNER_TIMEOUT_SECONDS=1800
GENBUILDER_TIMEOUT_SECONDS=1800
SSE_KEEPALIVE_SECONDS=15
GENPLANNER_CACHE_TTL_SECONDS=3600
