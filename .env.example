# --- окружение ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=buildplanner.log

# --- внешние сервисы пайплайна ---
URBAN_API=https://urban-api.testing.idulab.ru
GENPLANNER_API=http://genplanner:8080
GENBUILDER_API=http://genbuilder:8080
# Пусто — стадия очерёдности строительства выключена. Работает только вместе с PUBLISH_TO_URBAN.
SIRTEP_API=
CHAT_STORAGE_API=http://chat-history:8080

# --- LLM (vLLM, OpenAI-совместимый) ---
LLM_API=http://vllm:8000/v1
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=900

# --- Keycloak (service account: ChatStorage + запись сценариев в Urban API) ---
KEYCLOAK_URL=
KEYCLOAK_REALM=IDU
KEYCLOAK_CLIENT_ID=buildplanner
KEYCLOAK_CLIENT_SECRET=

# --- публикация результата и запуск расчёта оценок ---
# Выключено по умолчанию: включение пишет в общий стенд. Без сервисной учётки не включится.
PUBLISH_TO_URBAN=false
SERVICE_PROJECT_PREFIX=BuildPlanner
PUBLISH_ZONE_SOURCE=BuildPlanner
PUBLISH_MAX_CONCURRENCY=8

# --- хранилище слоёв для истории чата ---
# Адрес сервиса, как его видит браузер: из него строятся ссылки на слои в истории чата.
PUBLIC_BASE_URL=
# MinIO, если заданы все четыре MINIO_*; если ни одного — локальный каталог OUTPUTS_DIR.
# MINIO_ADDRESS — S3 API (обычно порт 9000, не консоль на 9001); https:// включает TLS.
MINIO_ADDRESS=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_REGION=us-east-1
OUTPUTS_DIR=outputs

# --- очерёдность строительства (SIRTEP) ---
# Периоды считаются кварталами; темп — м² жилой площади домов и пятен сервисов за период.
SIRTEP_PERIODS=40
SIRTEP_MAX_AREA_PER_PERIOD=100000

# --- таймауты и лимиты пайплайна ---
URBAN_API_TIMEOUT_SECONDS=60
GENPLANNER_TIMEOUT_SECONDS=1800
GENBUILDER_TIMEOUT_SECONDS=1800
SIRTEP_TIMEOUT_SECONDS=1800
# ТЭПы считаются фоном после очереди: сколько ждать и как часто спрашивать.
SIRTEP_PROVISION_TIMEOUT_SECONDS=300
SIRTEP_POLL_SECONDS=5
SSE_KEEPALIVE_SECONDS=15
GENPLANNER_CACHE_TTL_SECONDS=3600
